{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguinboy1108/AI_Engineering_Playbook/schema/catalog.schema.json",
  "title": "AI Engineering Playbook Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_updated", "entries"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "catalog_updated": {
      "type": "string",
      "format": "date"
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "title",
        "content_type",
        "document_status",
        "evidence_status",
        "product_lifecycle",
        "last_verified",
        "review_frequency",
        "metadata_source",
        "retrieval",
        "topics"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^[^/].*\\.md$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "content_type": {
          "enum": [
            "guide",
            "pattern",
            "anti-pattern",
            "case-study",
            "adr",
            "digest",
            "certification-map"
          ]
        },
        "document_status": {
          "enum": ["draft", "current", "deprecated", "superseded", "archived"]
        },
        "evidence_status": {
          "enum": [
            "official",
            "reference-architecture",
            "project-validated",
            "official-plus-project-evidence",
            "engineering-inference",
            "experimental",
            "unverified"
          ]
        },
        "product_lifecycle": {
          "enum": [
            "ga",
            "preview",
            "experimental",
            "retirement-announced",
            "deprecated",
            "retired",
            "not-applicable",
            "mixed"
          ]
        },
        "last_verified": {
          "type": "string",
          "format": "date"
        },
        "next_review_due": {
          "type": "string",
          "format": "date"
        },
        "review_frequency": {
          "enum": ["weekly", "monthly", "quarterly", "on-change", "annual"]
        },
        "metadata_source": {
          "enum": ["front-matter", "catalog"]
        },
        "canonical_for": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "retrieval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default_grounding", "priority", "role"],
          "properties": {
            "default_grounding": { "type": "boolean" },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "role": {
              "enum": [
                "primary",
                "decision-context",
                "supporting-evidence",
                "recent-change-record",
                "historical-only"
              ]
            }
          }
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "vendors": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "related": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "supersedes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "superseded_by": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    }
  }
}
